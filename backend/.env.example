# Application Configuration
APP_NAME="LifeCopilot Backend"
ENV="development"
DEBUG=true
API_PREFIX="/api/v1"

# Database Configuration
# For local dev: postgresql+asyncpg://postgres:postgres@localhost:5432/lifecopilot
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/lifecopilot"

# Firebase Admin SDK Configuration
# Path to service account JSON file, e.g. "./firebase-credentials.json"
# If empty, Firebase Admin SDK will attempt to load credentials via Application Default Credentials (ADC)
FIREBASE_CREDENTIALS_PATH=""

# CORS Configuration
# Comma-separated list of origins allowed to access the API
ALLOWED_ORIGINS="http://localhost:4200,http://127.0.0.1:4200"
